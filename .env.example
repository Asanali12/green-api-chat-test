# Copy this file to .env and fill in your GREEN-API instance credentials.
# .env is gitignored — values here never get committed.
# These are only read locally by `npm run dev` to pre-fill the login form;
# they still get baked into the built JS bundle like any Vite VITE_ var, so
# don't use this for anything beyond local testing.

VITE_GREEN_API_ID_INSTANCE=
VITE_GREEN_API_API_TOKEN_INSTANCE=

# Optional — only needed if your instance's apiUrl differs from the default
# https://api.green-api.com shown in the console.
VITE_GREEN_API_URL=
